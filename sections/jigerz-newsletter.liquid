{% comment %}
  JIGERZ Newsletter Section
{% endcomment %}

{{ 'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700;800&display=swap' | stylesheet_tag }}

<section
  class="jz-newsletter"
  id="jz-newsletter-{{ section.id }}"
  style="--gold:{{ section.settings.gold_color }}; --gold-hover:{{ section.settings.gold_hover }}; --gold-tint:{{ section.settings.gold_color | color_modify: 'alpha', 0.15 }}; --gold-border:{{ section.settings.gold_color | color_modify: 'alpha', 0.3 }}; --black:{{ section.settings.bg_color }}; --cream:{{ section.settings.text_color }};"
>
  <div class="jz-gold-stripe top"></div>
  <div class="jz-gold-stripe bottom"></div>

  <div class="jz-orb jz-orb-1"></div>
  <div class="jz-orb jz-orb-2"></div>

  <div class="jz-ornament orn-1">✦</div>
  <div class="jz-ornament orn-2">✦</div>
  <div class="jz-ornament orn-3">✺</div>
  <div class="jz-ornament orn-4">✺</div>

  <div class="jz-nl-inner">
    {% if section.settings.badge_text != blank %}
      <div class="jz-nl-badge">
        <span class="jz-pulse-dot"></span>
        <span>{{ section.settings.badge_text | escape }}</span>
        {% if section.settings.badge_extra != blank %}
          <span class="jz-gift">— {{ section.settings.badge_extra | escape }}</span>
        {% endif %}
      </div>
    {% endif %}

    <h2 class="jz-nl-headline">
      {{ section.settings.headline_main | escape }}
      <span class="jz-accent">{{ section.settings.headline_accent | escape }}</span>
    </h2>

    {% if section.settings.subheading != blank %}
      <p class="jz-nl-sub">{{ section.settings.subheading }}</p>
    {% endif %}

    {% form 'customer', class: 'jz-nl-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="hidden" name="form_type" value="customer">
      {% if form.posted_successfully? %}
        <div class="jz-nl-form-inner jz-success">
          <svg class="jz-icon-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7"/></svg>
          <span style="flex:1; padding:14px 8px; color: var(--cream); font-weight: 500;">{{ 'general.newsletter_form.confirmation' | t | default: 'Thanks for subscribing!' }}</span>
        </div>
      {% else %}
        <div class="jz-nl-form-inner">
          <svg class="jz-icon-mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="4" width="20" height="16" rx="3"/>
            <path d="m2 7 10 6 10-6"/>
          </svg>
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.input_placeholder | escape }}"
            aria-label="Email"
            required
          />
          <button type="submit" name="commit">
            <span>
              {{ section.settings.button_text | escape }}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14"/><path d="m13 5 7 7-7 7"/>
              </svg>
            </span>
          </button>
        </div>
        {% if form.errors %}
          <div style="color: #c0392b; font-size: 12px; margin-top: 10px; text-align: center;">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </div>
        {% endif %}
      {% endif %}
    {% endform %}

    {% if section.blocks.size > 0 %}
      <div class="jz-nl-perks">
        {% for block in section.blocks %}
          {% if block.type == 'perk' %}
            <div class="jz-nl-perk" {{ block.shopify_attributes }}>
              <span class="jz-check">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M5 12l5 5L20 7"/></svg>
              </span>
              <span>{{ block.settings.text | escape }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #jz-newsletter-{{ section.id }} {
    position: relative;
    width: 100%;
    max-width: 1920px;
    margin: 0 auto;
    background: linear-gradient(140deg, var(--black) 0%, #1a1612 50%, var(--black) 100%);
    padding: 50px 24px 70px;
    overflow: hidden;
    color: var(--cream);
    font-family: 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  #jz-newsletter-{{ section.id }} * { box-sizing: border-box; }
  #jz-newsletter-{{ section.id }}::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(circle, rgba(200,155,60,0.08) 1px, transparent 1.5px);
    background-size: 38px 38px; pointer-events: none; opacity: 0.6;
  }
  #jz-newsletter-{{ section.id }} .jz-orb {
    position: absolute; border-radius: 50%; pointer-events: none;
    filter: blur(60px); opacity: 0.35; animation: jzDrift 16s ease-in-out infinite;
  }
  #jz-newsletter-{{ section.id }} .jz-orb-1 {
    width: 480px; height: 480px;
    background: radial-gradient(circle, var(--gold) 0%, transparent 70%);
    top: -200px; left: -100px;
  }
  #jz-newsletter-{{ section.id }} .jz-orb-2 {
    width: 560px; height: 560px;
    background: radial-gradient(circle, var(--gold-hover) 0%, transparent 70%);
    bottom: -260px; right: -120px;
    animation-delay: -8s;
  }
  #jz-newsletter-{{ section.id }} .jz-gold-stripe {
    position: absolute; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent 0%, var(--gold) 30%, var(--gold-hover) 50%, var(--gold) 70%, transparent 100%);
    opacity: 0.6;
  }
  #jz-newsletter-{{ section.id }} .jz-gold-stripe.top { top: 0; }
  #jz-newsletter-{{ section.id }} .jz-gold-stripe.bottom { bottom: 0; }
  #jz-newsletter-{{ section.id }} .jz-ornament {
    position: absolute; font-family: 'Instrument Serif', serif; font-style: italic;
    color: var(--gold); opacity: 0.18; pointer-events: none;
  }
  #jz-newsletter-{{ section.id }} .orn-1 { top: 80px; left: 10%; font-size: 80px; animation: jzFloat 6s ease-in-out infinite; }
  #jz-newsletter-{{ section.id }} .orn-2 { bottom: 90px; right: 12%; font-size: 60px; animation: jzFloat 7s ease-in-out infinite reverse; }
  #jz-newsletter-{{ section.id }} .orn-3 { top: 140px; right: 18%; font-size: 40px; animation: jzSpin 22s linear infinite; }
  #jz-newsletter-{{ section.id }} .orn-4 { bottom: 130px; left: 14%; font-size: 50px; animation: jzSpin 28s linear infinite reverse; }

  #jz-newsletter-{{ section.id }} .jz-nl-inner {
    position: relative; max-width: 820px; margin: 0 auto; text-align: center; z-index: 2;
  }

  #jz-newsletter-{{ section.id }} .jz-nl-badge {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 9px 18px 9px 14px;
    background: var(--gold-tint); border: 1px solid var(--gold-border);
    border-radius: 999px; font-size: 11px; font-weight: 600;
    letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--gold-hover); margin-bottom: 32px;
    backdrop-filter: blur(8px);
    animation: jzRise 0.7s cubic-bezier(.2,.7,.3,1) both;
  }
  #jz-newsletter-{{ section.id }} .jz-pulse-dot {
    position: relative; width: 7px; height: 7px;
    border-radius: 50%; background: var(--gold);
  }
  #jz-newsletter-{{ section.id }} .jz-pulse-dot::before {
    content: ''; position: absolute; inset: -4px;
    border-radius: 50%; background: var(--gold); opacity: 0.4;
    animation: jzPulseRing 1.8s ease-out infinite;
  }
  #jz-newsletter-{{ section.id }} .jz-gift {
    font-family: 'Instrument Serif', serif; font-style: italic; font-weight: 400;
    text-transform: none; letter-spacing: 0; font-size: 14px;
    color: var(--gold-hover); margin: 0 4px 0 2px;
  }

  #jz-newsletter-{{ section.id }} .jz-nl-headline {
    font-family: 'Instrument Serif', serif; font-size: 88px; line-height: 0.95;
    font-weight: 400; letter-spacing: -0.015em; color: var(--cream);
    margin-bottom: 22px;
    animation: jzRise 0.9s cubic-bezier(.2,.7,.3,1) both 0.1s;
  }
  #jz-newsletter-{{ section.id }} .jz-accent {
    font-style: italic; color: var(--gold); position: relative; display: inline-block;
  }
  #jz-newsletter-{{ section.id }} .jz-accent::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 6px;
    height: 3px; background: var(--gold);
    transform-origin: left;
    animation: jzDrawLine 1.2s cubic-bezier(.7,0,.3,1) both 1.1s;
  }
  #jz-newsletter-{{ section.id }} .jz-nl-sub {
    font-size: 16px; line-height: 1.6; color: rgba(244,237,227,0.65);
    max-width: 520px; margin: 0 auto 44px; font-weight: 400;
    animation: jzRise 0.9s cubic-bezier(.2,.7,.3,1) both 0.2s;
  }

  #jz-newsletter-{{ section.id }} .jz-nl-form {
    position: relative; max-width: 580px; margin: 0 auto 32px;
    animation: jzRise 0.9s cubic-bezier(.2,.7,.3,1) both 0.3s;
  }
  #jz-newsletter-{{ section.id }} .jz-nl-form-inner {
    position: relative; display: flex; align-items: center;
    background: rgba(244,237,227,0.05); border: 1px solid var(--gold-border);
    border-radius: 999px; padding: 6px; backdrop-filter: blur(12px);
    transition: all 0.3s ease;
  }
  #jz-newsletter-{{ section.id }} .jz-nl-form-inner:focus-within {
    border-color: var(--gold); background: rgba(244,237,227,0.08);
    box-shadow: 0 0 0 4px var(--gold-tint), 0 12px 40px rgba(0,0,0,0.3);
  }
  #jz-newsletter-{{ section.id }} .jz-icon-mail {
    width: 22px; height: 22px; color: var(--gold);
    margin: 0 14px 0 18px; flex-shrink: 0;
  }
  #jz-newsletter-{{ section.id }} .jz-nl-form input {
    flex: 1; background: transparent; border: none; outline: none;
    color: var(--cream); font-size: 15px; font-family: inherit;
    padding: 16px 8px; letter-spacing: 0.01em;
  }
  #jz-newsletter-{{ section.id }} .jz-nl-form input::placeholder { color: rgba(244,237,227,0.4); }
  #jz-newsletter-{{ section.id }} .jz-nl-form button {
    position: relative; display: inline-flex; align-items: center; gap: 10px;
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-hover) 100%);
    color: var(--black); border: none; border-radius: 999px;
    padding: 14px 26px; font-size: 12px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer;
    overflow: hidden; font-family: inherit;
    transition: all 0.3s cubic-bezier(.2,.7,.3,1);
  }
  #jz-newsletter-{{ section.id }} .jz-nl-form button::before {
    content: ''; position: absolute; top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: left 0.6s ease;
  }
  #jz-newsletter-{{ section.id }} .jz-nl-form button:hover {
    transform: translateY(-2px); box-shadow: 0 14px 30px rgba(184,134,11,0.4);
  }
  #jz-newsletter-{{ section.id }} .jz-nl-form button:hover::before { left: 100%; }
  #jz-newsletter-{{ section.id }} .jz-nl-form button span {
    position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 10px;
  }
  #jz-newsletter-{{ section.id }} .jz-nl-form button svg { transition: transform 0.3s; }
  #jz-newsletter-{{ section.id }} .jz-nl-form button:hover svg { transform: translateX(4px); }
  #jz-newsletter-{{ section.id }} .jz-success { padding: 4px 8px; }
  #jz-newsletter-{{ section.id }} .jz-success .jz-icon-mail { color: var(--gold); }

  #jz-newsletter-{{ section.id }} .jz-nl-perks {
    display: flex; justify-content: center; flex-wrap: wrap; gap: 32px;
    font-size: 12px; color: rgba(244,237,227,0.55);
    font-weight: 500; letter-spacing: 0.08em;
    animation: jzRise 0.9s cubic-bezier(.2,.7,.3,1) both 0.4s;
  }
  #jz-newsletter-{{ section.id }} .jz-nl-perk {
    display: inline-flex; align-items: center; gap: 8px;
  }
  #jz-newsletter-{{ section.id }} .jz-check {
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--gold-tint); border: 1px solid var(--gold-border);
    color: var(--gold); display: grid; place-items: center; flex-shrink: 0;
  }

  @keyframes jzRise { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes jzDrift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(40px, -30px) scale(1.1); }
    66% { transform: translate(-30px, 40px) scale(0.95); }
  }
  @keyframes jzPulseRing { 0% { transform: scale(1); opacity: 0.5; } 100% { transform: scale(2.5); opacity: 0; } }
  @keyframes jzFloat { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-14px) rotate(8deg); } }
  @keyframes jzSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes jzDrawLine { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  @media (max-width: 760px) {
    #jz-newsletter-{{ section.id }} { padding: 36px 20px 50px; }
    #jz-newsletter-{{ section.id }} .jz-nl-headline { font-size: 52px; }
    #jz-newsletter-{{ section.id }} .jz-nl-sub { font-size: 14px; margin-bottom: 32px; }
    #jz-newsletter-{{ section.id }} .jz-nl-form-inner { flex-wrap: wrap; padding: 8px; }
    #jz-newsletter-{{ section.id }} .jz-nl-form input { padding: 14px 12px; width: 100%; min-width: 0; }
    #jz-newsletter-{{ section.id }} .jz-icon-mail { display: none; }
    #jz-newsletter-{{ section.id }} .jz-nl-form button { width: 100%; justify-content: center; padding: 14px; }
    #jz-newsletter-{{ section.id }} .jz-nl-perks { gap: 16px; font-size: 11px; }
    #jz-newsletter-{{ section.id }} .jz-ornament { display: none; }
  }
</style>

{% schema %}
{
  "name": "JIGERZ Newsletter",
  "tag": "section",
  "class": "jigerz-newsletter-section",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "gold_color", "label": "Gold", "default": "#B8860B" },
    { "type": "color", "id": "gold_hover", "label": "Gold (hover/light)", "default": "#C89B3C" },
    { "type": "color", "id": "bg_color", "label": "Background (dark)", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#F4EDE3" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "badge_text", "label": "Top badge", "default": "Members Only" },
    { "type": "text", "id": "badge_extra", "label": "Badge italic extra", "default": "get 10% off" },
    { "type": "text", "id": "headline_main", "label": "Headline (main)", "default": "Be first to the" },
    { "type": "text", "id": "headline_accent", "label": "Headline (italic accent)", "default": "drop." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Join 12,000+ members for early access to new collections, private sales, and styling guides — straight to your inbox." },
    { "type": "text", "id": "input_placeholder", "label": "Input placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Subscribe" }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Perk text", "default": "10% off first order" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JIGERZ Newsletter",
      "blocks": [
        { "type": "perk", "settings": { "text": "10% off first order" } },
        { "type": "perk", "settings": { "text": "Early access to drops" } },
        { "type": "perk", "settings": { "text": "No spam, unsubscribe anytime" } }
      ]
    }
  ]
}
{% endschema %}
